
{% assign local_time = "now" | date: "%s" | plus: trmnl.user.utc_offset %}

{% assign display_day = local_time | date: "%A" %}
{% assign display_date = local_time | date: "%d" %}
{% assign display_month = local_time | date: "%B" %}
{% assign display_year = local_time | date: "%Y" %}
{% assign display_time = local_time | date: "%I:%M" %}
{% assign display_period = local_time | date: "%p" %}

{% assign display_quote = quote_text | default: "A small step forward is still progress." %}
{% assign display_author = quote_author | default: "Daily Spark" %}
{% assign display_source = quote_source | default: "fallback" %}

{% assign quote_length = display_quote | size %}

{% assign quote_class = "ds-size-normal" %}

{% if quote_length > 210 %}
  {% assign quote_class = "ds-size-tiny" %}
{% elsif quote_length > 150 %}
  {% assign quote_class = "ds-size-small" %}
{% elsif quote_length > 90 %}
  {% assign quote_class = "ds-size-medium" %}
{% endif %}

